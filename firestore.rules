rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserDocument().data.active != false
        && currentUserDocument().data.roles.admin == true;
    }

    function isCollectionAssistant() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/coletaAtividadesAssistentes/$(request.auth.uid));
    }

    function allowedUserFields() {
      return [
        "name", "email", "active", "roles", "createdAt", "updatedAt", "lastLoginAt"
      ];
    }

    function hasOnlyAllowedUserFields() {
      return request.resource.data.keys().hasOnly(allowedUserFields());
    }

    function allowedUserUpdateFields() {
      return ["name", "email", "active", "roles", "updatedAt", "lastLoginAt"];
    }

    function updatesOnlyAllowedUserFields() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(allowedUserUpdateFields());
    }

    function preservesRoles() {
      return (
        resource.data.keys().hasAny(["roles"])
        && request.resource.data.roles == resource.data.roles
      ) || (
        !resource.data.keys().hasAny(["roles"])
        && request.resource.data.roles == {}
      );
    }

    function preservesActiveFlag() {
      return (
        resource.data.keys().hasAny(["active"])
        && request.resource.data.active == resource.data.active
      ) || (
        !resource.data.keys().hasAny(["active"])
        && request.resource.data.active == true
      );
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && hasOnlyAllowedUserFields()
        && request.resource.data.roles == {}
        && request.resource.data.active == true;
      allow update: if isSelf(userId)
        && updatesOnlyAllowedUserFields()
        && preservesRoles()
        && preservesActiveFlag();
    }

    match /events/{eventId} {
      allow read, create, update: if isAdmin();
    }

    match /events/{eventId}/leadScans/{scanId} {
      allow read, create: if isAdmin();
    }

    match /preInscritos/{preInscritoId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "nome", "nomeOrdenacao", "email", "whatsapp", "empresa", "origem", "importadoEm",
          "tokenPublico", "linkPublico", "mensagemWhatsApp", "mensagemVariante",
          "mensagemAtualizadaEm", "statusEnvioWhatsApp", "conviteGeradoEm"
        ]);
      allow update: if (isSignedIn() && !isCollectionAssistant()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "dataSelecionada", "atualizadoEm"]))
        || (!isSignedIn()
        && resource.data.tokenPublico is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "dataSelecionada", "atualizadoEm"])
        && request.resource.data.status == "confirmado"
        && request.resource.data.dataSelecionada in ["2026-09-22", "2026-09-23", "2026-09-24"]
        && getAfter(/databases/$(database)/documents/linksPublicos/$(resource.data.tokenPublico)).data.preInscritoId == preInscritoId
        && getAfter(/databases/$(database)/documents/linksPublicos/$(resource.data.tokenPublico)).data.status == "confirmado")
        || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "status", "atualizadoEm", "nome", "nomeOrdenacao", "email", "whatsapp", "empresa",
            "origem", "importadoEm", "tokenPublico", "linkPublico",
            "mensagemWhatsApp", "mensagemVariante", "mensagemAtualizadaEm",
            "statusEnvioWhatsApp", "conviteGeradoEm", "dataSelecionada"
          ]));
    }

    match /inscritos/{inscritoId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow create, update, delete: if isAdmin();
    }

    match /visitantesEstrategicos/{visitanteId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow create, update, delete: if isAdmin();
    }

    match /visitantes4Events/{visitanteId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
    }

    match /coletaAtividadesAssistentes/{assistenteId} {
      allow read: if isAdmin() || isSelf(assistenteId);
    }

    match /coletaAtividades/{atividadeId} {
      allow read: if isAdmin()
        || (isCollectionAssistant()
          && resource.data.responsavelIds.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();
    }

    match /coletaAtividadesRegistros/{registroId} {
      allow read: if isAdmin()
        || (isCollectionAssistant() && resource.data.assistenteId == request.auth.uid);
      allow create: if isCollectionAssistant()
        && !exists(/databases/$(database)/documents/coletaAtividadesRegistros/$(registroId))
        && request.resource.data.assistenteId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "atividadeId", "assistenteId", "qrcode", "registradoEm"
        ])
        && request.resource.data.qrcode is string
        && get(/databases/$(database)/documents/coletaAtividades/$(request.resource.data.atividadeId)).data.responsavelIds.hasAny([request.auth.uid]);
      allow update, delete: if isAdmin();
    }

    match /whatsappEventos/{eventId} {
      allow read: if request.auth != null && !isCollectionAssistant();
    }

    match /whatsappMensagens/{messageId} {
      allow read: if isAdmin();
    }

    match /whatsappRecebidas/{messageId} {
      allow read: if isAdmin();
    }

    match /configuracoes/{configuracaoId} {
      allow read, create, update: if isSignedIn() && !isCollectionAssistant();
    }

    // O ID de cada documento é um token aleatório de 256 bits. Não permitimos
    // listagem: somente quem recebeu o link consegue buscar o convite.
    match /linksPublicos/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["dataSelecionada", "confirmadoEm", "status"])
        && request.resource.data.status in ["pendente", "confirmado"])
        || (resource.data.status == "pendente"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["dataSelecionada", "confirmadoEm", "status"])
          && request.resource.data.dataSelecionada in [
            "2026-09-22", "2026-09-23", "2026-09-24"
          ]
          && request.resource.data.status == "confirmado"
          && request.resource.data.confirmadoEm == request.time);
    }
  }
}
