rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return currentUserDocument().data.get("roles", {}).get(role, false) == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserDocument().data.active != false
        && hasRole("admin");
    }

    function isCollectionAssistant() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserDocument().data.active != false
        && !hasRole("admin")
        && hasRole("assistenteColeta");
    }

    function isLeadSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserDocument().data.active != false
        && hasRole("vendedor");
    }

    function allowedUserFields() {
      return [
        "name", "email", "active", "roles", "createdAt", "updatedAt", "lastLoginAt"
      ];
    }

    function hasOnlyAllowedUserFields() {
      return request.resource.data.keys().hasOnly(allowedUserFields());
    }

    function allowedUserUpdateFields() {
      return ["name", "email", "active", "roles", "updatedAt", "lastLoginAt"];
    }

    function updatesOnlyAllowedUserFields() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(allowedUserUpdateFields());
    }

    function preservesRoles() {
      return (
        resource.data.keys().hasAny(["roles"])
        && request.resource.data.roles == resource.data.roles
      ) || (
        !resource.data.keys().hasAny(["roles"])
        && request.resource.data.roles == {}
      );
    }

    function preservesActiveFlag() {
      return (
        resource.data.keys().hasAny(["active"])
        && request.resource.data.active == resource.data.active
      ) || (
        !resource.data.keys().hasAny(["active"])
        && request.resource.data.active == true
      );
    }

    match /users/{userId} {
      // Cada pessoa consulta apenas o próprio perfil no login. As listas de
      // equipe administrativas são retornadas por uma Cloud Function.
      allow get: if isSelf(userId);
      allow create: if isSelf(userId)
        && hasOnlyAllowedUserFields()
        && request.resource.data.roles == {}
        && request.resource.data.active == true;
      allow update: if isSelf(userId)
        && updatesOnlyAllowedUserFields()
        && preservesRoles()
        && preservesActiveFlag();
    }

    match /events/{eventId} {
      allow read, create, update: if isAdmin();
    }

    match /events/{eventId}/leadScans/{scanId} {
      allow read, create: if isAdmin();
    }

    match /preInscritos/{preInscritoId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "nome", "nomeOrdenacao", "email", "whatsapp", "empresa", "origem", "importadoEm",
          "tokenPublico", "linkPublico", "mensagemWhatsApp", "mensagemVariante",
          "mensagemAtualizadaEm", "statusEnvioWhatsApp", "conviteGeradoEm"
        ]);
      allow update: if (!isSignedIn()
        && resource.data.tokenPublico is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "dataSelecionada", "atualizadoEm"])
        && request.resource.data.status == "confirmado"
        && request.resource.data.dataSelecionada in ["2026-09-22", "2026-09-23", "2026-09-24"]
        && getAfter(/databases/$(database)/documents/linksPublicos/$(resource.data.tokenPublico)).data.preInscritoId == preInscritoId
        && getAfter(/databases/$(database)/documents/linksPublicos/$(resource.data.tokenPublico)).data.status == "confirmado")
        || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "status", "atualizadoEm", "nome", "nomeOrdenacao", "email", "whatsapp", "empresa",
            "origem", "importadoEm", "tokenPublico", "linkPublico",
            "mensagemWhatsApp", "mensagemVariante", "mensagemAtualizadaEm",
            "statusEnvioWhatsApp", "conviteGeradoEm", "dataSelecionada"
          ]));
    }

    match /inscritos/{inscritoId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow create, update, delete: if isAdmin();
    }

    match /visitantesEstrategicos/{visitanteId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow create, update, delete: if isAdmin();
    }

    match /visitantes4Events/{visitanteId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow delete: if isAdmin();
    }

    // Fluxo independente de lembrete para download do aplicativo. Todas as
    // gravações passam pelas Cloud Functions; o painel administrativo só lê.
    match /lembretePresencaParticipantes/{participanteId} {
      allow read: if isAdmin();
    }

    match /lembretePresencaMensagens/{mensagemId} {
      allow read: if isAdmin();
    }

    match /lembretePresencaEventos/{eventoId} {
      allow read: if isAdmin();
    }

    match /lembretePresencaControleDiario/{dataId} {
      allow read: if isAdmin();
    }

    // Campanhas de WhatsApp isolam template, lista, prévia e histórico. Todas
    // as gravações passam pelas Cloud Functions; o painel administrativo lê.
    match /campanhasWhatsapp/{campanhaId} {
      allow read: if isAdmin();
    }

    match /campanhasWhatsapp/{campanhaId}/destinatarios/{destinatarioId} {
      allow read: if isAdmin();
    }

    match /campanhasWhatsappMensagens/{mensagemId} {
      allow read: if isAdmin();
    }

    match /campanhasWhatsappEventos/{eventoId} {
      allow read: if isAdmin();
    }

    match /campanhasWhatsappPreviews/{previewId} {
      allow read: if isAdmin();
    }

    match /campanhasWhatsappControleDiario/{controleId} {
      allow read: if isAdmin();
    }

    match /participantes4Events/{participanteId} {
      allow read: if isAdmin();
    }

    // Dados complementares importados por Excel. A gravação é feita somente
    // pela Cloud Function administrativa, que valida e normaliza cada linha.
    match /participantes4EventsComplementos/{complementoId} {
      allow read: if isAdmin();
    }

    // Estado operacional da integração e histórico de sorteios. Todas as
    // gravações são transacionais e realizadas pelas Cloud Functions.
    match /integracoes4Events/{integracaoId} {
      allow read: if isAdmin();
    }

    match /sorteios4Events/{sorteioId} {
      allow read: if isAdmin();
    }

    match /sorteios4EventsVencedores/{vencedorId} {
      allow read: if isAdmin();
    }

    match /sorteios4EventsTestes/{sessaoId} {
      allow read: if isAdmin();
    }

    match /sorteios4EventsTestes/{sessaoId}/{document=**} {
      allow read: if isAdmin();
    }

    match /coletaAtividades/{atividadeId} {
      allow read: if isAdmin()
        || (isCollectionAssistant()
          && resource.data.responsavelIds.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();
    }

    match /coletaAtividadesRegistros/{registroId} {
      allow read: if isAdmin()
        || (isCollectionAssistant() && resource.data.assistenteId == request.auth.uid);
      allow create: if isCollectionAssistant()
        && !exists(/databases/$(database)/documents/coletaAtividadesRegistros/$(registroId))
        && request.resource.data.assistenteId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "atividadeId", "assistenteId", "qrcode", "registradoEm"
        ])
        && request.resource.data.qrcode is string
        && get(/databases/$(database)/documents/coletaAtividades/$(request.resource.data.atividadeId)).data.responsavelIds.hasAny([request.auth.uid]);
      allow update, delete: if isAdmin();
    }

    // O resumo é gerado apenas pela Cloud Function; administradores consultam o resultado.
    match /retrospectivasEvento/{retrospectivaId} {
      allow read: if isAdmin();
      match /versoes/{versaoId} {
        allow read: if isAdmin();
      }
    }

    match /coletaLeadsConfiguracoes/{configuracaoId} {
      allow read: if isAdmin() || isLeadSeller();
      allow create, update, delete: if isAdmin();
    }

    match /coletaLeads/{leadId} {
      allow read: if isAdmin()
        || (isLeadSeller() && resource.data.vendedorId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /whatsappEventos/{eventId} {
      allow read: if request.auth != null && !isCollectionAssistant();
      allow update: if isAdmin()
        && request.resource.data.respondido is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "respondido", "respondidoEm", "respondidoPorUid"
        ]);
    }

    match /whatsappMensagens/{messageId} {
      allow read: if isAdmin();
    }

    match /whatsappRecebidas/{messageId} {
      allow read: if isAdmin();
    }

    match /configuracoes/{configuracaoId} {
      allow read: if isSignedIn() && !isCollectionAssistant();
      allow create, update: if isAdmin();
    }

    // Fluxo independente da pesquisa de satisfação. O ID da pesquisa é um
    // token aleatório presente apenas no link compartilhado com visitantes.
    match /pesquisasSatisfacao/{pesquisaId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "titulo", "descricao", "ativa", "perguntas", "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() <= 500
        && request.resource.data.ativa is bool
        && request.resource.data.perguntas is list
        && request.resource.data.perguntas.size() > 0
        && request.resource.data.perguntas.size() <= 50
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "titulo", "descricao", "ativa", "perguntas", "criadoEm", "atualizadoEm"
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "titulo", "descricao", "ativa", "perguntas", "atualizadoEm"
        ])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() <= 500
        && request.resource.data.ativa is bool
        && request.resource.data.perguntas is list
        && request.resource.data.perguntas.size() > 0
        && request.resource.data.perguntas.size() <= 50
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if isAdmin();
    }

    // Cada documento contém somente respostas anônimas e o horário de coleta.
    // Não há vínculo com participantes, usuários ou demais coleções do evento.
    match /respostasPesquisaSatisfacao/{respostaId} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          "pesquisaId", "respostas", "coletadoEm"
        ])
        && request.resource.data.pesquisaId is string
        && request.resource.data.pesquisaId.size() == 48
        && request.resource.data.respostas is list
        && request.resource.data.respostas.size() > 0
        && request.resource.data.respostas.size() <= 50
        && request.resource.data.coletadoEm == request.time
        && exists(/databases/$(database)/documents/pesquisasSatisfacao/$(request.resource.data.pesquisaId))
        && get(/databases/$(database)/documents/pesquisasSatisfacao/$(request.resource.data.pesquisaId)).data.ativa == true
        && request.resource.data.respostas.size() == get(/databases/$(database)/documents/pesquisasSatisfacao/$(request.resource.data.pesquisaId)).data.perguntas.size();
      allow update: if false;
    }

    // O ID de cada documento é um token aleatório de 256 bits. Não permitimos
    // listagem: somente quem recebeu o link consegue buscar o convite.
    match /linksPublicos/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["dataSelecionada", "confirmadoEm", "status"])
        && request.resource.data.status in ["pendente", "confirmado"])
        || (!isSignedIn()
          && resource.data.status == "pendente"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["dataSelecionada", "confirmadoEm", "status"])
          && request.resource.data.dataSelecionada in [
            "2026-09-22", "2026-09-23", "2026-09-24"
          ]
          && request.resource.data.status == "confirmado"
          && request.resource.data.confirmadoEm == request.time);
    }
  }
}
